{
  "name": "sentinel-cli",
  "version": "3.3.0",
  "description": "Minimalist AI coding assistant for the terminal (Pi-style). Multi-LLM, local tools, sessions, MCP — no servers, no telemetry.",
  "main": "src/cli/main.js",
  "type": "module",
  "bin": {
    "sentinel": "bin/sentinel.js"
  },
  "files": [
    "bin/**/*",
    "src/**/*",
    "mcp/**/*",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/sentinel.js",
    "ask": "node bin/sentinel.js ask",
    "mcp": "node mcp/sentinel-mcp-server.js",
    "test": "npm run test:unit && npm run test:tui && npm run test:jest",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:unit": "node --test __tests__/doctor.test.js __tests__/configManager.test.js __tests__/errorHandler.test.js __tests__/shared-tools.test.js __tests__/swe-workflow.test.js __tests__/cli-smoke.test.js __tests__/mcp-server.test.js __tests__/agent-loop.test.js __tests__/models-registry.test.js __tests__/providers.test.js __tests__/security-evals.test.js __tests__/harness.test.js __tests__/harness-teams.test.js __tests__/blast-radius.test.js __tests__/budget.test.js __tests__/handoff.test.js __tests__/watch.test.js __tests__/onboard.test.js __tests__/outcome.test.js __tests__/risk-ledger.test.js __tests__/ports.test.js __tests__/parity.test.js __tests__/features.test.js __tests__/receipts-replay.test.js __tests__/sessions-store.test.js",
    "bench": "node scripts/bench-swe-mini.js",
    "bench:security": "node scripts/bench-security-mini.js",
    "eval:check": "node evals/run.mjs --check",
    "eval:security": "node evals/security/run-security.mjs --check && node scripts/bench-security-mini.js",
    "eval:owasp": "node evals/security/run-security.mjs --owasp",
    "deepsec-scan": "node evals/security/run-security.mjs --deepsec-scan",
    "lint": "eslint bin/ src/ mcp/ __tests__/ scripts/ \"evals/**/*.mjs\"",
    "typecheck": "tsc -p src/tui/tsconfig.json --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "release:check": "npm run lint && npm run typecheck && npm run check:imports && npm test",
    "test:tui": "node --import tsx --test __tests__/tui.test.mjs __tests__/tui-overlay.test.mjs __tests__/tui-keybinds.test.mjs",
    "tui:snapshot": "tsx scripts/tui-snapshot.tsx",
    "tui:probe": "tsx --tsconfig src/tui/tsconfig.json scripts/tui-probe.tsx"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "agent",
    "llm",
    "openai",
    "gemini",
    "groq",
    "ollama",
    "mcp"
  ],
  "author": "Kunj Shah",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunjShah95/SENTINEL-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/KunjShah95/SENTINEL-CLI/issues"
  },
  "homepage": "https://github.com/KunjShah95/SENTINEL-CLI#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "diff": "^5.1.0",
    "ink": "^7.0.6",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "tsx": "^4.22.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
