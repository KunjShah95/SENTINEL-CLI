{
  "name": "sentinel-cli",
  "version": "3.0.0",
  "description": "Minimalist AI coding assistant for the terminal (Pi-style). Multi-LLM, local tools, sessions, MCP — no servers, no telemetry.",
  "main": "src/cli/main.js",
  "type": "module",
  "bin": {
    "sentinel": "bin/sentinel.js"
  },
  "files": [
    "bin/**/*",
    "src/**/*",
    "mcp/**/*",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/sentinel.js",
    "ask": "node bin/sentinel.js ask",
    "mcp": "node mcp/sentinel-mcp-server.js",
    "test": "npm run test:unit && npm run test:jest",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests __tests__/agent-context.test.js",
    "test:unit": "node --test __tests__/configManager.test.js __tests__/errorHandler.test.js __tests__/shared-tools.test.js",
    "lint": "eslint bin/ src/ mcp/",
    "typecheck": "tsc -p src/tui/tsconfig.json --noEmit",
    "check:imports": "node scripts/check-imports.mjs",
    "release:check": "npm run lint && npm run typecheck && npm run check:imports && npm test"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "agent",
    "llm",
    "openai",
    "gemini",
    "groq",
    "ollama",
    "mcp"
  ],
  "author": "Kunj Shah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunjShah95/SENTINEL-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/KunjShah95/SENTINEL-CLI/issues"
  },
  "homepage": "https://github.com/KunjShah95/SENTINEL-CLI#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "diff": "^5.1.0",
    "ink": "^7.0.6",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "tsx": "^4.22.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
