# ============================================================
# Sentinel CLI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in what you use.
# Never commit the .env file to version control!
#
# Zero-cost start: GROQ_API_KEY alone is enough (free tier),
# or run Ollama locally and use no key at all.
# ============================================================

# ── Free-tier default ──────────────────────────────────────
# Groq offers free API access to GPT-OSS, Qwen and Llama models.
# Default model: openai/gpt-oss-20b
GROQ_API_KEY=

# ── Local providers (no key needed) ────────────────────────
# OLLAMA_HOST=http://localhost:11434
# LMSTUDIO_HOST=http://localhost:1234

# ── Paid providers (optional) ──────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=

# ── Behavior ───────────────────────────────────────────────
# Verbose reasoning output in `sentinel ask`
# SENTINEL_VERBOSE=1
# Force-launch the TUI in non-interactive shells (debugging only)
# SENTINEL_FORCE_TTY=1
# Custom web-search endpoint for the searchWeb tool (defaults to DuckDuckGo HTML)
# SEARCH_WEB_ENDPOINT=https://html.duckduckgo.com/html/
# Session storage home (defaults to ~/.sentinel)
# SENTINEL_HOME=
